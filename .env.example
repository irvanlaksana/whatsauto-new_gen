# Hanya dipakai oleh server opsional (npm run server) untuk mode web.
# Aplikasi Android TIDAK membutuhkan file ini: API key diisi lewat UI aplikasi
# dan disimpan lokal di perangkat.

# Kunci Gemini untuk proxy /api/ai/reply
GEMINI_API_KEY=""

# Port server dev (vite mem-proxy /api ke port ini)
PORT="8787"
